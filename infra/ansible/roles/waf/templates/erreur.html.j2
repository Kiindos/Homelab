{# Page d'erreur du WAF — autonome (aucune ressource externe), claire et sombre selon le réglage du visiteur. #}
{% set e = waf_erreurs[code] %}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ code }} · {{ e.titre }}</title>
<style>
:root{--fond:#070b14;--carte:rgba(20,30,50,.7);--bord:rgba(148,163,184,.18);--texte:#e6edf7;--doux:#9aa9bf;--accent:{{ e.couleur | default('#2dd4bf') }};color-scheme:dark}
@media (prefers-color-scheme:light){:root{--fond:#f6f8fc;--carte:#fff;--bord:rgba(15,23,42,.1);--texte:#0f172a;--doux:#475569;color-scheme:light}}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;font:17px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--fond);color:var(--texte);
background-image:linear-gradient(var(--bord) 1px,transparent 1px),linear-gradient(90deg,var(--bord) 1px,transparent 1px);background-size:56px 56px}
main{width:min(100%,560px);padding:40px 36px;border-radius:20px;border:1px solid var(--bord);background:var(--carte);backdrop-filter:blur(12px);box-shadow:0 30px 80px -30px rgba(0,0,0,.55);text-align:center}
.logo{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#2dd4bf,#818cf8);margin-bottom:20px}
.logo svg{width:24px;height:24px;fill:none;stroke:#051018;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}
.code{font:800 clamp(64px,16vw,96px)/1 ui-monospace,Menlo,Consolas,monospace;letter-spacing:-.04em;margin:0;color:var(--accent)}
h1{font-size:1.5rem;margin:.6rem 0 .8rem;letter-spacing:-.02em}
p{color:var(--doux);margin:0 0 1rem}
.conseil{font-size:.95rem;padding:12px 16px;border-radius:12px;border:1px solid var(--bord);text-align:left}
.conseil strong{color:var(--texte)}
a.bouton{display:inline-block;margin-top:1.2rem;padding:.75rem 1.3rem;border-radius:12px;font-weight:650;color:#041014;background:linear-gradient(135deg,#2dd4bf,#818cf8);text-decoration:none}
footer{margin-top:1.6rem;font:.8rem ui-monospace,Menlo,monospace;color:var(--doux)}
</style>
</head>
<body>
<main>
  <span class="logo" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M8 22V10l8 7 8-7v12"/></svg></span>
  <p class="code">{{ code }}</p>
  <h1>{{ e.titre }}</h1>
  <p>{{ e.texte }}</p>
  <p class="conseil"><strong>Que faire ?</strong> {{ e.conseil }}</p>
  <a class="bouton" href="/">Revenir à l'accueil du service</a>
  <footer>{{ domaine_public }} · protégé par le pare-feu applicatif du homelab</footer>
</main>
</body>
</html>
