# {{ ansible_managed }}
# WAF BunkerWeb (image tout-en-un) : TLS, règles OWASP (ModSecurity + CRS), filtrage par pays, limitation
# de débit, bannissement des comportements suspects, CrowdSec. Seul point d'entrée depuis Internet.
name: waf

services:
  bunkerweb:
    image: {{ waf_image }}
    restart: unless-stopped
    ports:
      - "80:8080/tcp"   # challenge Let's Encrypt et redirection vers HTTPS
      - "443:8443/tcp"
      - "443:8443/udp"  # HTTP/3
    volumes:
      - bw-donnees:/data
      - ./erreurs:/var/www/html/homelab/erreurs:ro
      - ./charte:/var/www/html/homelab/charte:ro
      - ./nginx:{{ waf_conf_sans_appsec | dirname }}:ro
    environment:
      TZ: Europe/Paris
      # Pas d'interface d'administration exposée : la configuration vient uniquement d'Ansible.
      SERVICE_UI: "no"
      # Pas d'envoi de données à l'éditeur.
      USE_BUNKERNET: "no"
      SEND_ANONYMOUS_REPORT: "no"
      USE_CROWDSEC: "yes"

      MULTISITE: "yes"
      SERVER_NAME: "{{ waf_sites.keys() | map('regex_replace', '$', '.' ~ domaine_public) | join(' ') }}"
      # Une requête pour un nom inconnu (scan sur l'IP) est rejetée sans réponse.
      DISABLE_DEFAULT_SERVER: "yes"
      DISABLE_DEFAULT_SERVER_STRICT_SNI: "yes"

      # Certificats Let's Encrypt par challenge HTTP : aucun jeton DNS sur cette machine exposée.
      AUTO_LETS_ENCRYPT: "yes"
      AUTO_REDIRECT_HTTP_TO_HTTPS: "yes"
      HTTP3: "yes"

      # Pages d'erreur personnalisées, communes à tous les sites.
      ROOT_FOLDER: /var/www/html/homelab
      ERRORS: "{% for c in waf_erreurs %}{{ c }}=/erreurs/{{ c }}.html{{ ' ' if not loop.last }}{% endfor %}"
      INTERCEPTED_ERROR_CODES: "{{ waf_erreurs.keys() | join(' ') }}"

      # Réglages communs à tous les sites
      WHITELIST_COUNTRY: "{{ waf_pays_autorises }}"
      USE_MODSECURITY: "yes"
      USE_MODSECURITY_CRS: "yes"
      USE_BAD_BEHAVIOR: "yes"
      # 401 (session expirée, visiteur non connecté) et 404 (image absente…) sont normaux pour les applications :
      # seuls les refus du WAF (403) et les requêtes invalides comptent pour le bannissement.
      BAD_BEHAVIOR_STATUS_CODES: "{{ waf_codes_suspects }}"
      BAD_BEHAVIOR_BAN_TIME: "{{ waf_duree_bannissement }}"
      USE_LIMIT_REQ: "yes"
      USE_DNSBL: "no"
      # Les applications gèrent leurs propres sessions et API : pas de défi anti-robot.
      USE_ANTIBOT: "no"
      STRICT_TRANSPORT_SECURITY: "max-age=31536000; includeSubDomains"
      USE_REVERSE_PROXY: "yes"
      REVERSE_PROXY_URL: "/"
      REVERSE_PROXY_KEEPALIVE: "yes"
      # Les applications renvoient des erreurs en JSON (API, applis mobiles) : ne pas les remplacer par des pages HTML.
      REVERSE_PROXY_INTERCEPT_ERRORS: "no"
      # $no_appsec n'est posé que dans les chemins d'envoi (site.envois) : ailleurs, sa lecture par le module CrowdSec
      # écrivait un avertissement « uninitialized variable » à chaque requête.
      CUSTOM_CONF_HTTP_homelab: "uninitialized_variable_warn off;"

      # Réglages propres à chaque site
{% for nom, site in waf_sites.items() %}
{% set fqdn = nom ~ '.' ~ domaine_public %}
      {{ fqdn }}_REVERSE_PROXY_HOST: "{{ site.cible }}"
      {{ fqdn }}_REVERSE_PROXY_WS: "{{ 'yes' if site.websocket | default(false) else 'no' }}"
      {{ fqdn }}_MAX_CLIENT_SIZE: "{{ site.taille_max | default('10m') }}"
      {{ fqdn }}_REVERSE_PROXY_MAX_CLIENT_SIZE: "{{ site.taille_max | default('10m') }}"
{% set nb_sans_sso = site.sso.sans_sso | default([]) | length if site.sso is defined else 0 %}
{% for chemin in site.envois | default([]) %}
{% set n = nb_sans_sso + loop.index %}
      # {{ chemin }} : envois de fichiers. ModSecurity et AppSec (CrowdSec) chargent tout le corps d'une requête en
      # mémoire pour l'inspecter, quelle que soit leur limite : une vidéo de 1 Go faisait tuer nginx et saturait le WAF
      # (30/09). Sur ce seul chemin, le corps n'est pas inspecté ; bannissements, filtrage par pays, limite de débit et
      # authentification de l'application restent appliqués. nginx garde la mise en tampon (sur disque, pas en
      # mémoire) : transmis au fil de l'eau, un envoi interrompu arrivait tronqué chez Immich (400, 30/09).
      {{ fqdn }}_REVERSE_PROXY_URL_{{ n }}: "{{ chemin }}"
      {{ fqdn }}_REVERSE_PROXY_HOST_{{ n }}: "{{ site.cible }}"
      {{ fqdn }}_REVERSE_PROXY_MODSECURITY_{{ n }}: "no"
      {{ fqdn }}_REVERSE_PROXY_INCLUDES_{{ n }}: "{{ waf_conf_sans_appsec }}"
      {{ fqdn }}_REVERSE_PROXY_MAX_CLIENT_SIZE_{{ n }}: "{{ site.taille_max | default('10m') }}"
      {{ fqdn }}_REVERSE_PROXY_KEEPALIVE_{{ n }}: "yes"
      {{ fqdn }}_REVERSE_PROXY_INTERCEPT_ERRORS_{{ n }}: "no"
{% endfor %}
{% if site.greffons_crs | default('') %}
      {{ fqdn }}_USE_MODSECURITY_CRS_PLUGINS: "yes"
      {{ fqdn }}_MODSECURITY_CRS_PLUGINS: "{{ site.greffons_crs }}"
{% endif %}
{% if site.limite_debit | default('') %}
      {{ fqdn }}_LIMIT_REQ_RATE: "{{ site.limite_debit }}"
{% endif %}
{% if site.methodes | default('') %}
      {{ fqdn }}_ALLOWED_METHODS: "{{ site.methodes }}"
{% endif %}
{% if site.exclusions_modsec | default([]) %}
      # Exclusions ciblées de règles OWASP (faux positifs constatés), appliquées avant le chargement du CRS.
      {{ fqdn }}_CUSTOM_CONF_MODSEC_CRS_exclusions: {{ site.exclusions_modsec | join('\n') | to_json }}
{% endif %}
{% set conf_charte %}
# Fichiers de la charte du homelab (feuille de style, logos), servis par le WAF lui-même.
location ^~ /charte/ {
    alias /var/www/html/homelab/charte/;
    expires 1d;
}
location = /favicon.ico {
    alias /var/www/html/homelab/charte/favicon.ico;
    expires 7d;
}
{% endset %}
{% set conf_sso %}
# Vérification de la session SSO auprès d'Authelia (auth_request) : 200 = accès, 401 = renvoi vers le portail.
location = /.homelab-sso {
    internal;
    proxy_pass {{ site.sso.verification | default('') }};
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
    proxy_set_header X-Forwarded-For $remote_addr;
}
{% endset %}
{% if site.charte | default(false) %}
      # Charte du homelab : feuille de style injectée dans les pages HTML, fichiers servis par le WAF sous /charte/.
      {{ fqdn }}_INJECT_HEAD: '<link rel="stylesheet" href="/charte/{{ site.charte }}">'
{% endif %}
{% if site.sso is defined %}
      # Connexion obligatoire par le SSO : chaque requête est vérifiée auprès d'Authelia avant d'atteindre la cible,
      # qui reçoit l'identité dans Remote-User / Remote-Groups (valeurs envoyées par le client écrasées).
      {{ fqdn }}_REVERSE_PROXY_AUTH_REQUEST: /.homelab-sso
      {{ fqdn }}_REVERSE_PROXY_AUTH_REQUEST_SIGNIN_URL: "{{ site.sso.portail }}/?rd=$$scheme://$$http_host$$request_uri"
      {{ fqdn }}_REVERSE_PROXY_AUTH_REQUEST_SET: "$$sso_utilisateur $$upstream_http_remote_user;$$sso_groupes $$upstream_http_remote_groups"
      {{ fqdn }}_REVERSE_PROXY_HEADERS: "Remote-User $$sso_utilisateur;Remote-Groups $$sso_groupes"
{% for chemin in site.sso.sans_sso | default([]) %}
      # {{ chemin }} : même cible sans la barrière SSO (applications qui s'authentifient elles-mêmes, ex. applis
      # mobiles) ; l'identité envoyée par le client est effacée, pour que la cible ne puisse jamais s'y fier.
      {{ fqdn }}_REVERSE_PROXY_URL_{{ loop.index }}: "{{ chemin }}"
      {{ fqdn }}_REVERSE_PROXY_HOST_{{ loop.index }}: "{{ site.cible }}"
      {{ fqdn }}_REVERSE_PROXY_HEADERS_{{ loop.index }}: 'Remote-User "";Remote-Groups ""'
      {{ fqdn }}_REVERSE_PROXY_KEEPALIVE_{{ loop.index }}: "yes"
      {{ fqdn }}_REVERSE_PROXY_INTERCEPT_ERRORS_{{ loop.index }}: "no"
{% endfor %}
{% endif %}
{% set conf = (conf_charte if site.charte | default(false) else '') ~ (conf_sso if site.sso is defined else '') %}
{% if conf %}
      {{ fqdn }}_CUSTOM_CONF_SERVER_HTTP_homelab: {{ conf | trim | to_json(ensure_ascii=False) | replace('$', '$$') }}
{% endif %}
{% for cle, valeur in (site.autres | default({})).items() %}
      {{ fqdn }}_{{ cle }}: "{{ valeur }}"
{% endfor %}
{% endfor %}

volumes:
  bw-donnees:
