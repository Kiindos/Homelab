#!/bin/bash
# {{ ansible_managed }}
# Sauvegarde hors site : exports des VM, instantanés ZFS des données, configuration de l'hyperviseur -> restic.
# Journal : journalctl -u sauvegarde-homelab ; état : {{ sauvegarde_textfile }}/sauvegarde.prom
#
#   sauvegarde-homelab                   sauvegarde de la nuit (minuterie), vérification d'un septième du dépôt
#   sauvegarde-homelab controle-rapide   contrôle à la demande : structure du dépôt + 5 % des données relues
#   sauvegarde-homelab controle-complet  contrôle à la demande : tout le dépôt relu, exports de VM comparés
#                                        (après un incident ou une maintenance chez l'hébergeur ; Semaphore)
set -euo pipefail

MODE="${1:-sauvegarder}"
case "$MODE" in sauvegarder|controle-rapide|controle-complet) ;; *) echo "Mode inconnu : $MODE" >&2; exit 2 ;; esac

# Une seule opération à la fois sur le dépôt ; la suivante attend son tour (6 h au plus) au lieu d'être sautée.
exec 9>/run/sauvegarde-homelab.lock
flock -w 21600 9 || { echo "Le dépôt est occupé depuis plus de 6 h : abandon."; exit 1; }

export RESTIC_REPOSITORY='{{ sauvegarde_depot }}'
export RESTIC_PASSWORD_FILE=/root/.config/restic/homelab
export RESTIC_CACHE_DIR=/var/cache/restic
# Mémoire limitée sur l'hyperviseur : ramasse-miettes de Go plus fréquent.
export GOGC=40
# Verrous laissés par un passage interrompu (coupure chez l'hébergeur, 01/10) : sans eux, le contrôle et la rétention
# échouent. « unlock » ne retire que les verrous de processus disparus ; le verrou ci-dessus garantit qu'aucune autre
# opération du homelab n'est en cours.
restic unlock 2>&1 | grep -v '^$' || true

LOCAL='/{{ sauvegarde_dataset_local }}'
METRIQUES='{{ sauvegarde_textfile }}/sauvegarde.prom'
DATASETS=({% for d in sauvegarde_datasets %}'{{ d.dataset }}' {% endfor %})
DEBUT=$(date +%s)
AJOUTE=0
# Vérification de fin de passage : -1 = pas atteinte (échec avant), 0 = empreintes différentes, 1 = conforme.
VERIF=-1
VERIF_FICHIERS=0
VERIF_OCTETS=0
VERIF_ECARTS=0

# --- Contrôle à la demande (sans nouvelle sauvegarde) ---------------------------------------------------------
# Métriques à part (homelab_sauvegarde_controle_*) : celles de la sauvegarde de la nuit restent intactes.
if [ "$MODE" != sauvegarder ]; then
    CONTROLE_METRIQUES='{{ sauvegarde_textfile }}/sauvegarde-controle.prom'
    CONTROLE=0
    fin_controle() {
        local statut=$? reussite
        reussite=$(sed -n 's/^homelab_sauvegarde_controle_derniere_reussite_timestamp \([0-9]*\)$/\1/p' \
            "$CONTROLE_METRIQUES" 2>/dev/null || true)
        if [ "$CONTROLE" -eq 1 ]; then reussite=$(date +%s); fi
        {
            echo "# HELP homelab_sauvegarde_controle_statut 1 : dernier contrôle à la demande conforme ; 0 : écart ou échec."
            echo "homelab_sauvegarde_controle_statut $CONTROLE"
            echo "homelab_sauvegarde_controle_complet $([ "$MODE" = controle-complet ] && echo 1 || echo 0)"
            echo "homelab_sauvegarde_controle_derniere_execution_timestamp $(date +%s)"
            echo "homelab_sauvegarde_controle_duree_secondes $(( $(date +%s) - DEBUT ))"
            if [ -n "$reussite" ]; then echo "homelab_sauvegarde_controle_derniere_reussite_timestamp $reussite"; fi
        } > "${CONTROLE_METRIQUES}.tmp"
        mv "${CONTROLE_METRIQUES}.tmp" "$CONTROLE_METRIQUES"
        exit "$statut"
    }
    trap fin_controle EXIT
    ECARTS=0
    if [ "$MODE" = controle-complet ]; then
        # Exports de VM : gardés sur place depuis la dernière sauvegarde, comparés entièrement à leur copie dans le
        # dernier instantané (un export plus récent que l'instantané, sauvegarde ratée, est signalé à part).
        INSTANTANE=$(restic snapshots --tag homelab --json | python3 -c \
            'import json,sys; s=json.load(sys.stdin); print(max(s, key=lambda x: x["time"])["id"] if s else "")')
        [ -n "$INSTANTANE" ] || { echo "Aucun instantané dans le dépôt."; exit 1; }
        echo "== Exports de VM comparés au dernier instantané (${INSTANTANE:0:8})"
{% if sauvegarde_vm %}
        while IFS= read -r -d '' export_vm; do
            source=$(sha256sum "$export_vm" | cut -d' ' -f1)
            relu=$(restic dump --quiet "$INSTANTANE" "$export_vm" | sha256sum | cut -d' ' -f1) || relu="relecture-impossible"
            if [ "$source" = "$relu" ]; then echo "conforme : $(basename "$export_vm")"
            else echo "ÉCART : $(basename "$export_vm") (source ${source:0:16}…, relu ${relu:0:16}…)"; ECARTS=$((ECARTS + 1)); fi
        done < <(find "$LOCAL/vzdump" -maxdepth 1 -type f -name 'vzdump-qemu-*' ! -name '*.log' ! -name '*.notes' -print0)
{% endif %}
        echo "== Relecture de tout le dépôt (restic check --read-data)"
        restic check --read-data || ECARTS=$((ECARTS + 1))
    else
        echo "== Structure du dépôt et relecture de 5 % des données (restic check --read-data-subset=5%)"
        restic check --read-data-subset=5% || ECARTS=$((ECARTS + 1))
    fi
    if [ "$ECARTS" -eq 0 ]; then CONTROLE=1; echo "Contrôle « $MODE » conforme."; exit 0; fi
    echo "Contrôle « $MODE » en échec ($ECARTS problème(s)) : voir ci-dessus."
    exit 1
fi

# Instantanés créés par ce script seulement (nom fixe « sauvegarde »), supprimés à la fin de chaque passage.
nettoyer() {
    for ds in "${DATASETS[@]}"; do
        if zfs list -H -o name "${ds}@sauvegarde" >/dev/null 2>&1; then
            zfs destroy "${ds}@sauvegarde"
        fi
    done
}

ecrire_metriques() {
    local statut=$1 reussite espace reussi=0
    reussite=$(sed -n 's/^homelab_sauvegarde_derniere_reussite_timestamp \([0-9]*\)$/\1/p' "$METRIQUES" 2>/dev/null || true)
    local verif_ok
    verif_ok=$(sed -n 's/^homelab_sauvegarde_verification_derniere_reussite_timestamp \([0-9]*\)$/\1/p' "$METRIQUES" 2>/dev/null || true)
    if [ "$VERIF" -eq 1 ]; then verif_ok=$(date +%s); fi
    if [ "$statut" -eq 0 ]; then
        reussi=1
        reussite=$(date +%s)
    fi
    espace=$(ssh -o BatchMode=yes sauvegarde-distante df 2>/dev/null | awk 'NR==2 && $2>0 {printf "%.4f", $3/$2}' || true)
    {
        echo "# HELP homelab_sauvegarde_statut 1 si la dernière sauvegarde a réussi."
        echo "# TYPE homelab_sauvegarde_statut gauge"
        echo "homelab_sauvegarde_statut $reussi"
        echo "homelab_sauvegarde_derniere_execution_timestamp $(date +%s)"
        if [ -n "$reussite" ]; then echo "homelab_sauvegarde_derniere_reussite_timestamp $reussite"; fi
        echo "homelab_sauvegarde_duree_secondes $(( $(date +%s) - DEBUT ))"
        echo "homelab_sauvegarde_ajoute_octets ${AJOUTE:-0}"
        if [ -n "$espace" ]; then echo "homelab_sauvegarde_espace_utilise_ratio $espace"; fi
        echo "# HELP homelab_sauvegarde_verification_statut 1 : empreintes SHA-256 conformes ; 0 : écart ; -1 : non atteinte."
        echo "homelab_sauvegarde_verification_statut $VERIF"
        echo "homelab_sauvegarde_verification_ecarts $VERIF_ECARTS"
        echo "homelab_sauvegarde_verification_fichiers $VERIF_FICHIERS"
        echo "homelab_sauvegarde_verification_octets $VERIF_OCTETS"
        if [ -n "$verif_ok" ]; then echo "homelab_sauvegarde_verification_derniere_reussite_timestamp $verif_ok"; fi
    } > "${METRIQUES}.tmp"
    mv "${METRIQUES}.tmp" "$METRIQUES"
}

fin() {
    local statut=$?
    nettoyer || statut=1
    ecrire_metriques "$statut"
    exit "$statut"
}
trap fin EXIT

{% if sauvegarde_vm %}
echo "== Exports des VM (instantané à chaud, non compressés)"
vzdump {{ sauvegarde_vm | join(' ') }} --mode snapshot --compress 0 --dumpdir "$LOCAL/vzdump" \
    --prune-backups keep-last=1 --quiet 1
{% endif %}

echo "== Instantanés des données"
nettoyer
for ds in "${DATASETS[@]}"; do
    zfs snapshot "${ds}@sauvegarde"
done

echo "== Envoi vers le dépôt restic"
restic backup --tag homelab --exclude-caches --json \
{% for d in sauvegarde_datasets %}{% for e in d.exclusions | default([]) %}
    --exclude '/{{ d.dataset }}/.zfs/snapshot/sauvegarde/{{ e }}' \
{% endfor %}{% endfor %}
    {{ sauvegarde_chemins | join(' ') }} \
{% if sauvegarde_vm %}
    "$LOCAL/vzdump" \
{% endif %}
{% for d in sauvegarde_datasets %}
    '/{{ d.dataset }}/.zfs/snapshot/sauvegarde' \
{% endfor %}
    > "$LOCAL/dernier-envoi.json"
AJOUTE=$(sed -n 's/.*"data_added":\([0-9]*\).*/\1/p' "$LOCAL/dernier-envoi.json" | tail -1)
grep '"message_type":"summary"' "$LOCAL/dernier-envoi.json" || true

echo "== Rétention"
restic forget --tag homelab --keep-daily {{ sauvegarde_retention.quotidiennes }} \
    --keep-weekly {{ sauvegarde_retention.hebdomadaires }} --keep-monthly {{ sauvegarde_retention.mensuelles }}

# --- Vérification : ce qui est chez l'hébergeur est bien ce qui a été envoyé --------------------------------
# 1. De bout en bout : empreinte SHA-256 de chaque export de VM et d'un échantillon de fichiers de données, calculée
#    sur la source puis sur le fichier relu depuis l'instantané restic qui vient d'être créé (téléchargé).
# 2. Dépôt : chaque nuit, un septième des données stockées est relu et ses empreintes contrôlées
#    (restic check --read-data-subset=N/7) : tout le dépôt est vérifié en une semaine.
INSTANTANE=$(sed -n 's/.*"snapshot_id":"\([0-9a-f]*\)".*/\1/p' "$LOCAL/dernier-envoi.json" | tail -1)
[ -n "$INSTANTANE" ] || { echo "Identifiant de l'instantané introuvable : vérification impossible."; VERIF=0; exit 1; }
echo "== Vérification des empreintes (instantané ${INSTANTANE:0:8})"
verifier() {
    local chemin=$1 source restitue
    source=$(sha256sum "$chemin" | cut -d' ' -f1)
    # Relecture impossible (réseau, dépôt) : comptée comme un écart, jamais comme un succès.
    restitue=$(restic dump --quiet "$INSTANTANE" "$chemin" | sha256sum | cut -d' ' -f1) || restitue="relecture-impossible"
    VERIF_FICHIERS=$((VERIF_FICHIERS + 1))
    VERIF_OCTETS=$((VERIF_OCTETS + $(stat -c %s "$chemin")))
    if [ "$source" != "$restitue" ]; then
        echo "ÉCART : $chemin (source ${source:0:16}…, relu ${restitue:0:16}…)"
        VERIF_ECARTS=$((VERIF_ECARTS + 1))
    fi
}
{% if sauvegarde_vm %}
while IFS= read -r -d '' export_vm; do
    verifier "$export_vm"
done < <(find "$LOCAL/vzdump" -maxdepth 1 -type f -name 'vzdump-qemu-*' ! -name '*.log' ! -name '*.notes' -print0)
{% endif %}
{% for d in sauvegarde_datasets %}
while IFS= read -r -d '' fichier; do
    verifier "$fichier"
done < <(find '/{{ d.dataset }}/.zfs/snapshot/sauvegarde' -type f{% for e in d.exclusions | default([]) %} ! -path '/{{ d.dataset }}/.zfs/snapshot/sauvegarde/{{ e }}/*'{% endfor %} -print0 \
         | shuf -z -n {{ sauvegarde_echantillon_fichiers }})
{% endfor %}
echo "$VERIF_FICHIERS fichiers comparés ($((VERIF_OCTETS / 1048576)) Mio), $VERIF_ECARTS écart(s)."

echo "== Vérification du dépôt (part $(date +%u)/7 des données relue)"
DEPOT_OK=1
restic check --read-data-subset="$(date +%u)/7" || DEPOT_OK=0
# Verdict posé à la toute fin seulement : tout échec avant laisse « non atteinte » (-1).
if [ "$VERIF_ECARTS" -eq 0 ] && [ "$DEPOT_OK" -eq 1 ] && [ "$VERIF_FICHIERS" -gt 0 ]; then VERIF=1; else VERIF=0; fi

if [ "$(LC_ALL=C date +%a)" = "{{ sauvegarde_jour_maintenance }}" ]; then
    echo "== Maintenance : nettoyage du dépôt"
    restic prune
fi
[ "$VERIF" -eq 1 ] || { echo "Vérification en échec : la sauvegarde n'est pas digne de confiance."; exit 1; }
echo "Sauvegarde terminée et vérifiée."
