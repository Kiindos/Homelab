# {{ ansible_managed }}
[Unit]
Description=Publication du site {{ site.key }} depuis la branche {{ site.value.branche }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/synchro-site {{ site.key }} {{ site.value.depot }} {{ site.value.branche }}
# Isolement : lecture seule partout, sauf le dossier des sites.
ProtectSystem=strict
ReadWritePaths={{ web_dossier }}
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
