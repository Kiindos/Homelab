# {{ ansible_managed }}
# Identité : annuaire LLDAP, portail SSO Authelia et son cache de sessions.
name: identite

services:
  lldap:
    image: {{ identite_image_lldap }}
    restart: unless-stopped
    env_file: .env
    environment:
      TZ: Europe/Paris
      LLDAP_LDAP_BASE_DN: "{{ identite_base_dn }}"
      LLDAP_HTTP_URL: "https://ldap.{{ domaine_interne }}"
      LLDAP_JWT_SECRET_FILE: /run/secrets/lldap_jwt_secret
      LLDAP_LDAP_USER_PASS_FILE: /run/secrets/lldap_admin_password
      LLDAP_LDAPS_OPTIONS__ENABLED: "true"
      LLDAP_LDAPS_OPTIONS__PORT: "6360"
      LLDAP_LDAPS_OPTIONS__CERT_FILE: /run/secrets/ldaps.crt
      LLDAP_LDAPS_OPTIONS__KEY_FILE: /run/secrets/ldaps.key
    ports:
      # LDAPS pour les autres VM et interface web pour le proxy interne ; filtrés par OPNsense.
      - "6360:6360"
      - "17170:17170"
    volumes:
      - lldap:/data
      - ./amorcage:/amorcage:ro
    secrets: [lldap_jwt_secret, lldap_admin_password, ldaps.crt, ldaps.key]

  authelia:
    image: {{ identite_image_authelia }}
    restart: unless-stopped
    depends_on:
      # Authelia vérifie l'annuaire au démarrage : il attend que LLDAP soit prêt.
      lldap:
        condition: service_healthy
      valkey:
        condition: service_started
    environment:
      TZ: Europe/Paris
      # Autorise {{ '{{' }} secret "…" {{ '}}' }} dans la configuration (clé OIDC multiligne).
      X_AUTHELIA_CONFIG_FILTERS: template
      AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE: /run/secrets/authelia_reset_jwt
      AUTHELIA_SESSION_SECRET_FILE: /run/secrets/authelia_session
      AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE: /run/secrets/authelia_storage
      AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD_FILE: /run/secrets/authelia_ldap
      AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE: /run/secrets/authelia_oidc_hmac
{% if identite_smtp is defined %}
      AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE: /run/secrets/authelia_smtp
{% endif %}
    ports:
      # Portail, joignable uniquement depuis le WAF (filtré par OPNsense).
      - "9091:9091"
    volumes:
      - ./authelia/configuration.yml:/config/configuration.yml:ro
      - ./authelia/modeles:/config/modeles:ro
      - authelia:/config/data
    secrets: [authelia_reset_jwt, authelia_session, authelia_storage, authelia_ldap, authelia_oidc_hmac, authelia_oidc_jwks{% if identite_smtp is defined %}, authelia_smtp{% endif %}]
    security_opt: ["no-new-privileges:true"]

{% if identite_page_comptes | bool %}
  # Page des comptes : jointe par le proxy interne seulement (SSO imposé par lui, adresses vérifiées par la page).
  comptes:
    image: {{ identite_image_comptes }}
    restart: unless-stopped
    command: ["python3", "-u", "/app/app.py"]
    user: "65534:65534"
    depends_on: [lldap, authelia]
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      LLDAP_URL: http://lldap:17170
      LLDAP_MOT_DE_PASSE_FICHIER: /run/secrets/lldap_admin_password
      AUTHELIA_URL: http://authelia:9091
      PORTAIL: "{{ identite_url_portail }}"
      SOURCES_AUTORISEES: "{{ identite_comptes_sources | join(' ') }}"
      SOURCES_ANNONCES: "{{ identite_comptes_sources_annonces | join(' ') }}"
      ANNONCES_FICHIER: /donnees/annonces.json
      GROUPE_ADMIN: "{{ identite_comptes_groupe_admin }}"
      GROUPES_EXCLUS: "{{ identite_comptes_groupes_exclus | join(' ') }}"
      GROUPES_DESCRIPTIONS: {{ identite_comptes_descriptions | to_json | to_json }}
      DUREE_LIEN_HEURES: "{{ identite_duree_lien_heures }}"
      LIEN_ANNUAIRE: "{{ identite_comptes_lien_annuaire }}"
      # Quotas (drive, photos) : inactifs tant que leur secret est vide.
      NEXTCLOUD_URL: "{{ identite_comptes_quotas.nextcloud.url | default('') }}"
      NEXTCLOUD_HOTE: "{{ identite_comptes_quotas.nextcloud.hote | default('') }}"
      NEXTCLOUD_UTILISATEUR: "{{ identite_comptes_quotas.nextcloud.utilisateur | default('') }}"
      NEXTCLOUD_MOT_DE_PASSE_FICHIER: /run/secrets/comptes_nextcloud
      IMMICH_URL: "{{ identite_comptes_quotas.immich.url | default('') }}"
      IMMICH_CLE_FICHIER: /run/secrets/comptes_immich
{% if identite_smtp is defined %}
      # E-mail de bienvenue : même expéditeur (et même jeton SMTP) qu'Authelia ; services du catalogue.
      SMTP_SERVEUR: "{{ identite_smtp.serveur }}"
      SMTP_UTILISATEUR: "{{ identite_smtp.utilisateur }}"
      SMTP_EXPEDITEUR: "{{ identite_smtp.expediteur }}"
      SMTP_MOT_DE_PASSE_FICHIER: /run/secrets/authelia_smtp
      CATALOGUE_FICHIER: /app/catalogue.json
      CONTACT_ADMINISTRATEUR: "{{ identite_comptes_contact }}"
      REGLE_MOT_DE_PASSE: "{{ identite_regle_mot_de_passe }}"
{% endif %}
      TZ: Europe/Paris
    ports:
      - "{{ identite_comptes_port }}:8080"
    volumes:
      - ./comptes:/app:ro
      - ./annonces:/donnees
    secrets: [lldap_admin_password, comptes_nextcloud, comptes_immich{% if identite_smtp is defined %}, authelia_smtp{% endif %}]
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/sante', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3

{% endif %}
  valkey:
    image: {{ identite_image_valkey }}
    restart: unless-stopped
    command: ["valkey-server", "--save", "300", "1"]
    volumes:
      - valkey:/data
    security_opt: ["no-new-privileges:true"]

secrets:
{% for s in ['lldap_jwt_secret', 'lldap_admin_password', 'ldaps.crt', 'ldaps.key', 'authelia_reset_jwt', 'authelia_session', 'authelia_storage', 'authelia_ldap', 'authelia_oidc_hmac', 'authelia_oidc_jwks'] + (['authelia_smtp'] if identite_smtp is defined else []) + (['comptes_nextcloud', 'comptes_immich'] if identite_page_comptes | bool else []) %}
  {{ s }}:
    file: ./secrets/{{ s }}
{% endfor %}

volumes:
  lldap:
  authelia:
  valkey:
