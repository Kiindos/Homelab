# {{ ansible_managed }}
# Secrets : fournis par fichiers (variables *_FILE du Compose), jamais dans ce fichier.
theme: auto

server:
  address: "tcp://:9091/"

log:
  level: info

# Contrôle de l'horloge sur le pare-feu de la zone (NTP vers Internet bloqué par OPNsense).
ntp:
  address: "udp://{{ ansible_default_ipv4.gateway }}:123"

# Méthode proposée à qui n'en a pas encore choisi (le choix de chacun est ensuite retenu).
default_2fa_method: "{{ identite_methode_2fa_defaut }}"

totp:
  issuer: "{{ domaine_public }}"

webauthn:
  display_name: "Homelab {{ domaine_public }}"

authentication_backend:
  password_reset:
    disable: false
  ldap:
    address: "ldap://lldap:3890"
    implementation: lldap
    base_dn: "{{ identite_base_dn }}"
    user: "uid=authelia,ou=people,{{ identite_base_dn }}"

password_policy:
  standard:
    enabled: true
    min_length: {{ identite_mots_de_passe.longueur_min }}
    require_lowercase: {{ identite_mots_de_passe.minuscule | bool | lower }}
    require_uppercase: {{ identite_mots_de_passe.majuscule | bool | lower }}
    require_number: {{ identite_mots_de_passe.chiffre | bool | lower }}
    require_special: {{ identite_mots_de_passe.special | bool | lower }}

identity_validation:
  reset_password:
    # Lien reçu par e-mail pour choisir son mot de passe (oubli, invitation d'un nouveau compte) : usage unique.
    jwt_lifespan: "{{ identite_duree_lien_heures }}h"

access_control:
  # Tout ce qui n'est pas explicitement autorisé est refusé.
  default_policy: deny
  rules:
    - domain: "auth.{{ domaine_public }}"
      policy: bypass
{% for regle in identite_regles_acces %}
    - domain: {{ regle.domaine | to_json }}
{% if regle.ressources is defined %}
      resources: {{ regle.ressources | to_json }}
{% endif %}
      policy: {{ regle.politique }}
{% if regle.sujets is defined %}
      subject: {{ regle.sujets | to_json }}
{% endif %}
{% endfor %}

session:
  cookies:
    - domain: "{{ domaine_public }}"
      authelia_url: "{{ identite_url_portail }}"
      inactivity: "2 hours"
      expiration: "12 hours"
      remember_me: "1 month"
  redis:
    host: valkey
    port: 6379

regulation:
  # Bannissement après 5 échecs en 10 minutes.
  max_retries: 5
  find_time: "10 minutes"
  ban_time: "1 hour"

storage:
  local:
    path: /config/data/db.sqlite3

notifier:
  # Modèles d'e-mails en français, aux couleurs du homelab (templates/modeles du rôle).
  template_path: /config/modeles
{% if identite_smtp is defined %}
  smtp:
    address: "submission://{{ identite_smtp.serveur }}:587"
    username: "{{ identite_smtp.utilisateur }}"
    sender: "Homelab <{{ identite_smtp.expediteur }}>"
    subject: "{{ identite_sujet_emails }}"
    # Mot de passe (jeton SMTP) : fichier secret, variable AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE du Compose.
{% else %}
  # En attendant la configuration SMTP (Proton Mail) : messages écrits dans un fichier.
  filesystem:
    filename: /config/data/notifications.txt
{% endif %}

{% if identite_attributs_calcules %}
# Attributs dérivés des groupes (droits dans les applications), calculés à chaque connexion.
definitions:
  user_attributes:
{% for nom, expression in identite_attributs_calcules.items() %}
    {{ nom }}:
      expression: {{ expression | to_json }}
{% endfor %}

{% endif %}
identity_providers:
  oidc:
    jwks:
      - key_id: principale
        algorithm: RS256
        use: sig
        key: {{ '{{' }} secret "/run/secrets/authelia_oidc_jwks" | mindent 10 "|" | msquote {{ '}}' }}
    authorization_policies:
{% for nom, groupes in identite_politiques_oidc.items() %}
      {{ nom }}:
        default_policy: deny
        rules:
          - policy: two_factor
            subject: {{ groupes | map('regex_replace', '^', 'group:') | list | to_json }}
{% endfor %}
    claims_policies:
      # Pour les clients qui lisent l'identité dans le jeton d'identité plutôt qu'auprès de /userinfo (Semaphore).
      jeton_id_complet:
        id_token: [email, email_verified, preferred_username, name, groups]
{% for nom, politique in identite_politiques_claims.items() %}
      {{ nom }}:
{% if politique.id_token is defined %}
        id_token: {{ politique.id_token | to_json }}
{% endif %}
{% if politique.custom_claims is defined %}
        custom_claims:
{% for claim, attribut in politique.custom_claims.items() %}
          {{ claim }}:
            attribute: {{ attribut | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{% if identite_portees_oidc %}
    scopes:
{% for nom, claims in identite_portees_oidc.items() %}
      {{ nom }}:
        claims: {{ claims | to_json }}
{% endfor %}
{% endif %}
    clients:
{% for c in identite_clients_oidc %}
      - client_id: "{{ c.id }}"
        client_name: "{{ c.nom }}"
        client_secret: "{{ c.condensat }}"
        public: false
        authorization_policy: "{{ c.politique }}"
        consent_mode: implicit
        require_pkce: {{ c.pkce | default(false) | lower }}
{% if c.pkce | default(false) %}
        pkce_challenge_method: S256
{% endif %}
        redirect_uris:
{% for u in c.redirections %}
          - "{{ u }}"
{% endfor %}
        scopes: {{ c.scopes | default(['openid', 'profile', 'email', 'groups']) | to_json }}
        token_endpoint_auth_method: "{{ c.auth_jeton | default('client_secret_post') }}"
        userinfo_signed_response_alg: none
{% if c.claims is defined or c.jeton_id_complet | default(false) %}
        claims_policy: {{ c.claims | default('jeton_id_complet') }}
{% endif %}
{% endfor %}
