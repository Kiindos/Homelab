# Géré par Ansible (rôle common) — connexion par clé uniquement.
PermitRootLogin {{ common_ssh_root }}
PasswordAuthentication no
KbdInteractiveAuthentication no
X11Forwarding no
MaxAuthTries 3
# Pas de rebond par SSH (audit du 29/09, C18) : ni redirection de ports, ni d'agent, ni tunnel.
AllowTcpForwarding {{ common_ssh_redirections }}
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
# Algorithmes modernes seulement : échange de clés post-quantique ou Curve25519, chiffrement authentifié, MAC
# « encrypt-then-MAC » (ni SHA-1 ni UMAC-64).
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
