# {{ ansible_managed }}
# Alertes critiques : e-mail + notification sur téléphone (ntfy){% if supervision_sms_free.cle is defined %} + SMS (Free Mobile){% endif %}.
# Avertissements : affichés sur le NOC seulement.
global:
  smtp_smarthost: "{{ supervision_smtp.serveur }}:587"
  smtp_from: "Supervision homelab <{{ supervision_smtp.expediteur }}>"
  smtp_auth_username: "{{ supervision_smtp.utilisateur }}"
  smtp_auth_password_file: /etc/alertmanager/secrets/smtp
  smtp_require_tls: true

route:
  receiver: noc
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    - matchers: ['severite="critique"']
      receiver: critique
    # Veille de sécurité et mises à jour : un message par type d'alerte (liste des services concernés), rappel
    # chaque semaine tant que rien n'est fait, puis « résolu ». Ni SMS ni NOC.
    # Détection d'intrusion : chaque machine à part, notification prioritaire, rappel toutes les 12 h. Pas de SMS.
    - matchers: ['severite="securite"']
      receiver: securite
      group_by: [alertname, instance]
      group_wait: 30s
      repeat_interval: 12h
    - matchers: ['severite="veille"']
      receiver: veille
      group_by: [alertname]
      group_wait: 10m
      group_interval: 6h
      repeat_interval: 168h

receivers:
  - name: noc
  - name: critique
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[ALERTE]{{ '{{' }} else {{ '}}' }}[RÉSOLU]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} — {{ '{{' }} .CommonLabels.instance {{ '}}' }}'
    webhook_configs:
      # Modèle « alertmanager » intégré à ntfy : titre et message lisibles sur le téléphone.
      - url: "http://ntfy/{{ supervision_ntfy_sujet }}?template=alertmanager&priority=high"
        send_resolved: true
        http_config:
          basic_auth:
            username: alertmanager
            password_file: /etc/alertmanager/secrets/ntfy
{% if supervision_sms_free.cle is defined %}
      # SMS au titulaire de la ligne Free Mobile (relais « sms » de la pile).
      - url: "http://sms:8080/alertmanager"
        send_resolved: true
{% endif %}

  - name: veille
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[VEILLE]{{ '{{' }} else {{ '}}' }}[FAIT]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} ({{ '{{' }} len .Alerts.Firing {{ '}}' }})'
    webhook_configs:
      - url: "http://ntfy/{{ supervision_ntfy_sujet }}?template=alertmanager&priority=default"
        send_resolved: false
        http_config:
          basic_auth:
            username: alertmanager
            password_file: /etc/alertmanager/secrets/ntfy

  - name: securite
    email_configs:
      - to: "{{ supervision_email_alertes }}"
        send_resolved: true
        headers:
          Subject: '{{ '{{' }} if eq .Status "firing" {{ '}}' }}[SÉCURITÉ]{{ '{{' }} else {{ '}}' }}[FIN]{{ '{{' }} end {{ '}}' }} {{ '{{' }} .CommonLabels.alertname {{ '}}' }} — {{ '{{' }} .CommonLabels.instance {{ '}}' }}'
    webhook_configs:
      - url: "http://ntfy/{{ supervision_ntfy_sujet }}?template=alertmanager&priority=high"
        send_resolved: false
        http_config:
          basic_auth:
            username: alertmanager
            password_file: /etc/alertmanager/secrets/ntfy

# Une alerte critique masque l'avertissement équivalent sur la même machine.
inhibit_rules:
  - source_matchers: ['severite="critique"']
    target_matchers: ['severite="avertissement"']
    equal: [instance]
