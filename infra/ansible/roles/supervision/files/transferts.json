{
 "uid": "transferts",
 "title": "Transferts",
 "tags": [
  "import"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "description": "Travaux d'import en cours ou passés (métriques homelab_import_*, relevées chaque minute).",
 "panels": [
  {
   "id": 1,
   "type": "table",
   "title": "Travaux",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_etat",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_octets",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_total_octets",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_pourcentage",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_debit_octets",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_eta_secondes",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_erreurs",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "travail": "Travail",
       "Value #A": "État",
       "Value #B": "Copié",
       "Value #C": "Total",
       "Value #D": "Avancement",
       "Value #E": "Débit",
       "Value #F": "Fin estimée dans",
       "Value #G": "Erreurs"
      },
      "indexByName": {
       "travail": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "Value #E": 5,
       "Value #F": 6,
       "Value #G": 7
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "md"
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "État"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "jamais lancé",
            "color": "text"
           },
           "1": {
            "text": "en cours",
            "color": "blue"
           },
           "2": {
            "text": "terminé",
            "color": "green"
           },
           "3": {
            "text": "en échec",
            "color": "red"
           },
           "4": {
            "text": "programmé (nuit)",
            "color": "purple"
           },
           "5": {
            "text": "interrompu",
            "color": "orange"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Copié"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Total"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Avancement"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Débit"
      },
      "properties": [
       {
        "id": "unit",
        "value": "Bps"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Fin estimée dans"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Erreurs"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 1
          },
          {
           "color": "red",
           "value": 50
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Volume copié",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_octets",
     "legendFormat": "{{travail}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Débit",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_import_debit_octets",
     "legendFormat": "{{travail}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}