{
 "uid": "stockage",
 "title": "Stockage et e-mails",
 "tags": [
  "stockage",
  "courriels"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "5m",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "description": "Occupation des jeux de données et du pool (relevée toutes les 15 min sur l'hyperviseur) ; e-mails du relais transactionnel (Scaleway, relevés toutes les 15 min).",
 "panels": [
  {
   "id": 1,
   "type": "bargauge",
   "title": "Occupation par jeu de données",
   "description": "Part de la place permise (quota, ou reste du pool) déjà occupée, instantanés compris.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "homelab_stockage_utilise_octets / (homelab_stockage_utilise_octets + homelab_stockage_disponible_octets)",
     "legendFormat": "{{jeu}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Pool : occupation",
