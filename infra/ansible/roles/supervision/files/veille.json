{
 "uid": "veille",
 "title": "Veille de sécurité",
 "tags": [
  "sécurité",
  "mises à jour"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "refresh": "5m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "description": "Résultats de la veille de sécurité (chaque nuit) et état des mises à jour des machines. Marche à suivre : runbook « Mises à jour ».",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Actions de sécurité",
   "description": "Avis de sécurité, failles corrigeables par une nouvelle construction, OPNsense en retard : alerte VeilleActionSecurite.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(homelab_veille_action == 1)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
