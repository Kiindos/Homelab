# OpenTofu / Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.auto.tfvars
terraform.tfvars
!*.tfvars.example

# Secrets (seuls les fichiers *.enc.* chiffrés par SOPS sont versionnés)
*.key
*.pem
age.txt
.env
.env.*
!.env.example
secrets/*
!secrets/*.enc.*

# Ansible
*.retry
.vault_pass*

# Divers
.DS_Store
.idea/
.vscode/
*.swp
infra/ansible/inventory/hosts.yml

# Contexte local Claude Code (détails internes, jamais versionné)
CLAUDE.md
# Permissions Claude Code propres au poste (jamais versionnées)
.claude/settings.local.json

# Python
__pycache__/

# Hugo (verrou de construction, résultats locaux)
.hugo_build.lock
site/public/
site/resources/_gen/

# ansible-lint (cache local)
.ansible/
